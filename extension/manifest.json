{
  "manifest_version": 3,
  "name": "ApplyTrack",
  "version": "1.0.2",
  "description": "Your personal AI job application copilot.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://main.d3uomahh7oyjyy.amplifyapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyTrack"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}